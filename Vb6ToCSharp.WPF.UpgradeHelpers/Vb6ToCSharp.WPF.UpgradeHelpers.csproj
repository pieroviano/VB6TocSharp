<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageOutputPath>$(SolutionDir)Packages/</PackageOutputPath>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <!-- namespaces are shared with the base package: they stay Vb6ToCSharp.UpgradeHelpers.* -->
        <RootNamespace>Vb6ToCSharp.UpgradeHelpers</RootNamespace>
        <Copyright>Copyright (c) Piero Viano 2026. All rights reserved.</Copyright>
        <Description>WPF controls and helpers for VB6 programs converted to C# by Vb6ToCSharp.</Description>
        <UseWPF>true</UseWPF>
        <LangVersion>latest</LangVersion>
        <PackageId>Net4x.$(MSBuildProjectName)</PackageId>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573;CS0419</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Vb6ToCSharp.WPF.UpgradeHelpers.Tests" />
    </ItemGroup>
    <ItemGroup>
        <!-- the VB6 CommonDialog is the WinForms one: it serves WPF forms as well -->
        <ProjectReference Include="..\Vb6ToCSharp.WinForms.UpgradeHelpers\Vb6ToCSharp.WinForms.UpgradeHelpers.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" />
    </ItemGroup>
    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="$(SolutionDir)README.md" />
        <None Update="README.md" Pack="true" PackagePath="\" />
        <Content Include="$(SolutionDir)License.txt" Link="License.txt" Pack="true" PackagePath="\License.txt" Condition="Exists('$(SolutionDir)License.txt')" />
    </ItemGroup>
</Project>