<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
    <PropertyGroup>
        <PackageOutputPath>$(SolutionDir)Packages/</PackageOutputPath>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>Vb6ToCSharp</RootNamespace>
        <DontConvert>False</DontConvert>
        <Copyright>Copyright 2026</Copyright>
        <!-- VbExtension is the WPF runtime shim for converted code: it needs the WPF assemblies -->
        <UseWPF>true</UseWPF>
        <!-- the WinForms back-end writes typed .resx resources (Bitmap/Icon) -->
        <UseWindowsForms>true</UseWindowsForms>
        <LangVersion>latest</LangVersion>
        <PackageId>Net4x.$(MSBuildProjectName)</PackageId>
        <NoWarn>$(NoWarn);NETSDK1137;NU1510</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CSharp" Version="4.7.0.$(VersionBuildSuffix)" />
        <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" />
    </ItemGroup>
    <ItemGroup>
        <COMReference Include="ADODB">
            <Guid>{B691E011-1797-432E-907A-4D8C69339129}</Guid>
            <VersionMajor>6</VersionMajor>
            <VersionMinor>1</VersionMinor>
            <Lcid>0</Lcid>
            <WrapperTool>tlbimp</WrapperTool>
            <Isolated>False</Isolated>
            <EmbedInteropTypes>True</EmbedInteropTypes>
        </COMReference>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Vb6ToCSharp.Tests" />
    </ItemGroup>
    <ItemGroup>
        <None Include="Vb6ToCSharp.sample.ini" />
    </ItemGroup>
    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="$(SolutionDir)README.md" />
        <!-- Net4x.NuGetUtility packs the solution README: this package has its own -->
        <None Update="README.md" Pack="true" PackagePath="\" />
        <Content Include="$(SolutionDir)License.txt" Link="License.txt" Pack="true" PackagePath="\License.txt" Condition="Exists('$(SolutionDir)License.txt')" />
    </ItemGroup>
</Project>